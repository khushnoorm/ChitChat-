rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions
    // =========================================================================

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isOptionalString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function getConversationData(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    function isParticipantInData(convData) {
      return isSignedIn()
        && convData != null
        && convData.participants is list
        && request.auth.uid in convData.participants;
    }

    function isConversationParticipant(conversationId) {
      return isParticipantInData(getConversationData(conversationId));
    }

    function isConversationNotBlocked(conversationId) {
      let conv = getConversationData(conversationId);
      return isParticipantInData(conv)
        && (!('blockedBy' in conv) || (conv.blockedBy is list && conv.blockedBy.size() == 0));
    }

    function isValidAttachment(att) {
      return att == null || (
        att is map
        && isValidString(att.name, 1, 255)
        && att.type in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'image/gif',
          'application/pdf',
          'text/plain'
        ]
        && att.size is int
        && att.size > 0
        && att.size <= 5 * 1024 * 1024
        && isValidString(att.url, 1, 700000)
      );
    }

    function isValidReplyTo(replyTo) {
      return replyTo == null || (
        replyTo is map
        && isValidString(replyTo.messageId, 1, 128)
        && isValidString(replyTo.senderId, 1, 128)
        && isValidString(replyTo.senderName, 1, 100)
        && isValidString(replyTo.textPreview, 0, 300)
      );
    }

    // =========================================================================
    // User Profiles (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && isValidString(request.resource.data.displayName, 1, 60)
        && isValidString(request.resource.data.username, 2, 40)
        && isOptionalString(request.resource.data.bio, 250)
        && isOptionalString(request.resource.data.photoURL, 500000)
        && isOptionalString(request.resource.data.avatarColor, 32);

      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && isValidString(request.resource.data.displayName, 1, 60)
        && isValidString(request.resource.data.username, 2, 40)
        && isOptionalString(request.resource.data.bio, 250)
        && isOptionalString(request.resource.data.photoURL, 500000)
        && isOptionalString(request.resource.data.avatarColor, 32);

      allow delete: if false;

      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // =========================================================================
    // Private Conversations (/conversations/{conversationId})
    // =========================================================================
    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && resource != null
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      allow delete: if isSignedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;

      // =======================================================================
      // Conversation Messages (/conversations/{conversationId}/messages/{msgId})
      // =======================================================================
      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);

        allow create: if isConversationNotBlocked(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && isValidString(request.resource.data.senderName, 1, 80)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && (
            request.resource.data.text.size() > 0
            || request.resource.data.attachment != null
            || request.resource.data.encrypted == true
          )
          && request.resource.data.createdAt == request.time
          && request.resource.data.status in ['sent', 'delivered', 'read']
          && request.resource.data.deleted == false
          && request.resource.data.edited == false
          && isValidAttachment(request.resource.data.get('attachment', null))
          && isValidReplyTo(request.resource.data.get('replyTo', null));

        allow update: if isConversationParticipant(conversationId)
          && request.resource.data.senderId == resource.data.senderId
          && (
            (
              resource.data.senderId == request.auth.uid
              && request.resource.data.text is string
              && request.resource.data.text.size() <= 4000
            )
            ||
            (
              resource.data.senderId != request.auth.uid
              && request.resource.data.text == resource.data.text
              && request.resource.data.deleted == resource.data.deleted
              && request.resource.data.edited == resource.data.edited
            )
          );

        allow delete: if isConversationParticipant(conversationId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    // =========================================================================
    // Abuse & Safety Reports (/reports/{reportId})
    // =========================================================================
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && isValidString(request.resource.data.reportedUserId, 1, 128)
        && isValidString(request.resource.data.reason, 3, 100)
        && isOptionalString(request.resource.data.details, 1500)
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
